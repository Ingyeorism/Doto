# Local defaults work without this file. Copy to .env only to change them.
PORT=3000
HOST=0.0.0.0
# External deployment: set DOMAIN to your actual DNS hostname.
DOMAIN=doto.example.com
PUBLIC_URL=https://doto.example.com
# STUN addresses for direct WebRTC connections.
STUN_URLS=stun:stun.l.google.com:19302
# Structured server + browser diagnostics; active file and backups total about 25 MiB.
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_FILES=5
